GEMINI_API_KEY=your_api_key_here
PORT=3000
FRONTEND_DOMAINS=http://localhost:3001

# Firebase Admin SDK — required for auth + Firestore history
# Either set FIREBASE_SERVICE_ACCOUNT (raw JSON or base64-encoded JSON of a
# service account key) or rely on application default credentials (e.g. when
# running on GCP) and only set FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT=
RECAPTCHA_API_KEY=your_recaptcha_api_key_here
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
